# Packing rules for the standalone face-api deploy.
.venv/
__pycache__/
*.pyc
run-local.sh
requirements-local.txt
Dockerfile
.DS_Store
# Ship insightface/models/buffalo_sc (15MB — fits the deploy archive's
# 600s upload window and the free tier's 256MB instance) but keep the
# 198MB buffalo_l weights out. Excluding the dir itself (gitignore cannot
# re-include children of an excluded dir) — do NOT exclude /insightface/
# wholesale: vendor/insightface-src/insightface is a separate path, but the
# bundled models live exactly here.
/insightface/models/buffalo_l/
