# ─── Photo source ───────────────────────────────────────────────
# drive (Google Drive folder, default) | yandex (public Yandex Disk share link)
PHOTO_SOURCE="drive"
# For PHOTO_SOURCE=yandex: public link to a folder the photographer shared
# (https://disk.yandex.ru/d/… or yadi.sk/d/…). No token needed.
# The pipeline phases (describe/embeddings/face) work with Drive only.
YANDEX_DISK_FOLDER_URL=""

# ─── Google Cloud ───────────────────────────────────────────────
# Option 1: API Key (for publicly shared folders)
GOOGLE_API_KEY=
# Option 2: Service Account (for private/restricted folders)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Required: Root Drive folder ID (from the folder URL: drive.google.com/drive/folders/{THIS})
GOOGLE_DRIVE_FOLDER_ID=

# ─── Gemini AI ─────────────────────────────────────────────────
# Required: Gemini API key for vision analysis and embeddings (from aistudio.google.com)
GEMINI_API_KEY=

# ─── Supabase ──────────────────────────────────────────────────
# Required: Supabase project URL and service role key
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Authentication ────────────────────────────────────────────
# Required: Password attendees enter to access the gallery
APP_PASSWORD=
# Required: Bearer token for admin API endpoints
ADMIN_API_SECRET=

# ─── Face Matching (Optional) ─────────────────────────────────
# Deploy services/face-api/ on Railway/Render/Fly, then set the URL here
# If not configured, face matching features are disabled
FACE_API_URL=
FACE_API_SECRET=

# ─── Event Branding (white-label) ──────────────────────────────
# Every value below is optional — sensible defaults are built in.
# NOTE: always quote hex colors — dotenv reads a bare leading "#"
# as the start of a comment and would drop the value.
NEXT_PUBLIC_EVENT_NAME="Event Photos"
NEXT_PUBLIC_EVENT_TAGLINE="Find your photos"
# Hero statement (two-tone): the first sentence is drawn light, the rest
# after the first period is painted in the event accent color.
NEXT_PUBLIC_HERO_STATEMENT="Вся съёмка с мероприятия. И ваши кадры в ней"
# Supporting line under the hero statement (browse + selfie hints).
NEXT_PUBLIC_EVENT_DESCRIPTION="Сделайте селфи — найдём ваши фото. Или просто листайте галерею по альбомам"
NEXT_PUBLIC_EVENT_YEAR="2026"

# Organizer logo (SVG or PNG, ideally transparent, ≤512px tall).
# Leave empty to show the event name as text only.
NEXT_PUBLIC_LOGO_URL=""

# Color scheme: dark | light
NEXT_PUBLIC_THEME="dark"

# Brand colors (6-digit hex)
NEXT_PUBLIC_PRIMARY_COLOR="#3b82f6"
NEXT_PUBLIC_SECONDARY_COLOR="#f59e0b"
NEXT_PUBLIC_ACCENT_COLOR="#3b82f6"

# Surfaces & text (6-digit hex). Leave empty to inherit from the theme.
NEXT_PUBLIC_BG_COLOR=""
NEXT_PUBLIC_SURFACE_COLOR=""
NEXT_PUBLIC_TEXT_COLOR=""

# Footer credit line (shown above the privacy note). Leave empty to hide.
NEXT_PUBLIC_FOOTER_CREDIT_TEXT=""
NEXT_PUBLIC_FOOTER_CREDIT_URL=""
